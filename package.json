{
  "name": "semio-final",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Semio Final: plataforma para el final oral de Semiología (bolillero, cronograma, temas, maniobras, simulador oral y repasos con ChatGPT)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:content": "node scripts/check-content.mjs",
    "preguntas": "node scripts/build-preguntas.mjs",
    "pdf": "node scripts/build-pdfs.mjs http://localhost:4791/semio-final/",
    "pdf:parcial": "node scripts/build-pdf-parcial.mjs http://localhost:4791/semio-final/",
    "videos:temas": "esbuild scripts/videos-temas.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/videos-temas.mjs --log-level=warning && node node_modules/.tmp/videos-temas.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "tts": "node scripts/tts.mjs",
    "tts:clase": "node scripts/tts-clase.mjs",
    "video:render": "remotion render video/src/index.ts",
    "check:parcial": "esbuild scripts/check-parcial.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/check-parcial.mjs --log-level=warning && node node_modules/.tmp/check-parcial.mjs",
    "check:final": "esbuild scripts/check-final.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/check-final.mjs --log-level=warning && node node_modules/.tmp/check-final.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@remotion/player": "^4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.541",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^23.10.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
